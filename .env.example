# ══════════════════════════════════════════════════════════════════════════════
# GovLens India — Environment Variables
#
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# ══════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/govlens

# Port the API server listens on (Replit sets this automatically)
PORT=8080

# Node environment — set to "production" in deployed environments
NODE_ENV=development

# ── Security (required in production) ─────────────────────────────────────────

# Random secret used to sign session cookies.
# Generate: openssl rand -hex 32
# The server will refuse to start in production without this set.
SESSION_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# Secret token for admin-only routes (GET/PATCH /api/admin/issues).
# Send as the X-Admin-Token request header — never in a URL query string.
# Generate: openssl rand -hex 24
ADMIN_TOKEN=replace-me-with-output-of-openssl-rand-hex-24

# ── Cloudflare (recommended for production) ───────────────────────────────────

# Cloudflare Turnstile secret key — verifies that visitors passed the bot check.
# Get a free key at https://www.cloudflare.com/products/turnstile/
# If unset, the always-pass test secret is used (fine for development, not production).
# TURNSTILE_SECRET_KEY=

# Cloudflare origin secret — a random value you set in a Cloudflare Transform Rule
# (Rules → Transform Rules → Modify Request Header → X-CF-Origin-Secret).
# Blocks requests that bypass Cloudflare and hit the origin directly.
# If unset, the server falls back to checking for the CF-Connecting-IP header.
# CF_ORIGIN_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────

# Restrict API access to a specific frontend origin.
# If unset, all origins are allowed (open CORS — fine for dev, set for prod).
# Example: ALLOWED_ORIGIN=https://govlens.in
# ALLOWED_ORIGIN=

# ── SMTP / Resend Email Configuration ──────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=your_resend_smtp_key_here
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Orange-Chasma Civic Brief" <newsletter@anaytech.in>
NEWSLETTER_FROM_EMAIL=newsletter@anaytech.in
