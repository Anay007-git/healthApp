{
  "functions": {
    "api/factcheck/verify.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api|admin|assets|maps|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
